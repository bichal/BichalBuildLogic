# Local settings and secrets for `bichal` (tools/bichal.py) and the publisher.
# Copy to .env next to this file (never committed: .gitignore lists it) and fill
# in what you use. Real environment variables always win over .env.
#
# `bichal secrets` copies the three tokens below into GitHub Actions secrets of
# every repository in mods.toml and bichal-build-logic (or, with --org, into
# organization secrets), so they are set in one place.

# Modrinth personal access token (scopes: create versions, write projects).
# https://modrinth.com/settings/pats
MODRINTH_TOKEN=

# CurseForge upload API token. https://legacy.curseforge.com/account/api-tokens
CURSEFORGE_TOKEN=

# GitHub token for bichal-build-logic's Mods workflow: it pushes the shared
# files to every mod and tags releases. Create it at
# https://github.com/settings/personal-access-tokens/new (fine-grained):
#   Resource owner       bichal (not your user: a user-owned token cannot
#                        push to the organization's repositories)
#   Repository access    Only select repositories: every mod in mods.toml
#                        (Celeris, Tessera, velox; add new mods here later)
#   Repository permissions
#     Contents           Read and write   (clone, commit, push, tags)
#     Workflows          Read and write   (the sync updates .github/workflows/)
#     Metadata           Read-only        (added automatically)
# If bichal requires approval of fine-grained tokens, approve it under
# the organization's Settings > Personal access tokens > Pending requests.
# Then add it as the secret BICHAL_SYNC_TOKEN of BichalBuildLogic (Settings >
# Secrets and variables > Actions), or run `bichal secrets`. Check it with
# `bichal token-check`, or the Mods workflow with action "token".
BICHAL_SYNC_TOKEN=

# Token for `gh` when publishing GitHub releases locally (`bichal publish`).
# Leave empty to use your `gh auth login` session.
GH_TOKEN=

# Folder holding the mod checkouts (default: the folder holding
# bichal-build-logic), for `bichal sync --all` and `bichal mods`.
BICHAL_MODS_DIR=
