#!/usr/bin/env sh
# bichal-build-logic's tool: ./bichal --help (needs Python 3.11+).
DIR=$(cd "$(dirname "$0")" && pwd)
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec "$py" "$DIR/tools/bichal.py" "$@"
  fi
done
echo "bichal needs Python 3.11 or newer (https://www.python.org/downloads/)." >&2
exit 1
